# All optional. Set these in Netlify > Site configuration > Environment variables.
# Server-side AI ("Aether Cloud") — never exposed to the browser.
NVIDIA_API_KEY=
AETHER_NVIDIA_MODEL=moonshotai/kimi-k3
ANTHROPIC_API_KEY=
AETHER_ANTHROPIC_MODEL=claude-sonnet-5-5
# Better search results (otherwise DuckDuckGo HTML with Wikipedia fallback).
BRAVE_SEARCH_API_KEY=
